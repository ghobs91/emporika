# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# PWA files
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/sw.js.map
**/public/workbox-*.js.map
**/public/worker-*.js.map

# generated Target catalog index (rebuild with scripts/target-sitemap.ts)
/data/target-index/

# Transformers.js model cache used by scripts/bench-embedding-models.ts
/.cache/

# generated Target corpus (~93MB, rebuilt weekly by .github/workflows/update-target-index.yml)
# served at runtime, never committed: committing it would add 93MB to history per refresh
/public/data/target-corpus.bin

# local agent tool state
/.serena/
