{
  "manifest_version": 3,
  "name": "Emporika Browser Search",
  "version": "0.1.0",
  "description": "Collects listings from Back Market and Costco inside your own browser, on Emporika's behalf.",
  "permissions": [
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://www.backmarket.com/*",
    "https://www.costco.com/*",
    "https://gdx-api.costco.com/*"
  ],
  "action": {
    "default_title": "Emporika: open provider harness"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://emporika.netlify.app/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
